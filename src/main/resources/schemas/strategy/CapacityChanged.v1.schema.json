{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos/schemas/strategy/CapacityChanged.v1.schema.json",
  "title": "CapacityChanged v1 payload",
  "description": "The capacity of the user's active week changed after the plan was activated (e.g. less time than planned).",
  "type": "object",
  "required": ["weeklyPlanId", "isoWeek", "previousCapacityMinutes", "capacityMinutes"],
  "additionalProperties": false,
  "properties": {
    "weeklyPlanId": {
      "type": "string",
      "format": "uuid"
    },
    "isoWeek": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "previousCapacityMinutes": {
      "type": "integer",
      "minimum": 0
    },
    "capacityMinutes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
